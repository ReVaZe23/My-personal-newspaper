<Window x:Class="MyPersonalNewspaper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:vm="clr-namespace:MyPersonalNewspaper.ViewModels"
        Title="My Personal Newspaper"
        Height="800" Width="1200"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/DeusExTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource BorderDim}" BorderThickness="1" CornerRadius="8" MouseLeftButtonDown="RootBorder_MouseLeftButtonDown" Background="{StaticResource BgBlack}">
        <Grid Background="#D9000000">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Text="◢" Foreground="{StaticResource NeonYellow}" FontSize="16" Margin="0,0,8,0"/>
                    <TextBlock Text="MY PERSONAL NEWSPAPER" Style="{StaticResource HeaderText}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Content="—" Style="{StaticResource DeusButton}" Width="32" Height="24" Margin="0,0,4,0" Click="Minimize_Click"/>
                    <Button Content="✕" Style="{StaticResource CloseButton}" Width="32" Height="24" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="24,8,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#80000000" BorderBrush="{StaticResource BorderDim}" BorderThickness="0,0,0,1" Padding="12" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DeusTextBox}" FontSize="16"/>
                        <Button Grid.Column="1" Content="SCAN" Command="{Binding SearchCommand}" Style="{StaticResource DeusButton}" Margin="4,0,16,0"/>
                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Currencies}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderDim}" BorderThickness="1" Margin="4,0" Padding="8,4" Background="#80000000">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding CharCode}" Foreground="#FFD0D0D0" FontFamily="Consolas" FontWeight="Bold" FontSize="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding DisplayValue}" Foreground="#FFD0D0D0" FontFamily="Consolas" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Margin="0,0,0,16">
                    <ItemsControl ItemsSource="{Binding Topics}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}" Command="{Binding DataContext.FilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource DeusButton}" Margin="0,0,8,0" Padding="12,4" FontSize="12"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <ScrollViewer x:Name="NewsScroller" Grid.Row="2" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,16">
                    <ItemsControl ItemsSource="{Binding TodayArticles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="220" Height="120" Background="#EE141414" BorderBrush="{StaticResource BorderDim}" BorderThickness="1" Margin="0,0,8,0" Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#FF1A1A1A" BorderBrush="{StaticResource BorderDim}" BorderThickness="0,0,1,0">
                                            <TextBlock Text="IMG" Foreground="{StaticResource BorderDim}" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8">
                                            <TextBlock Text="{Binding Title}" FontFamily="Georgia" FontSize="12" FontWeight="Bold" Foreground="#FFD0D0D0" TextWrapping="Wrap" MaxHeight="50" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SourceName}" Style="{StaticResource DimTextStyle}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenArticleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid Grid.Row="3">
                    <Grid Visibility="{Binding IsFeedVisible, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="350"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,16,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Height="250" Background="#EE1A1A1A" BorderBrush="{StaticResource BorderDim}" BorderThickness="1" Margin="0,0,0,16">
                                <TextBlock Text="[ НЕТ ИЗОБРАЖЕНИЯ ]" Foreground="{StaticResource BorderDim}" FontFamily="Consolas" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                                <TextBlock Text="{Binding FeaturedArticle.Title}" FontFamily="Georgia" FontSize="28" FontWeight="Bold" Foreground="#FFD0D0D0" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding FeaturedArticle.SourceName}" Style="{StaticResource DimTextStyle}" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding FeaturedArticle.Description}" Style="{StaticResource BodyText}" FontSize="14" TextWrapping="Wrap" MaxHeight="100" TextTrimming="CharacterEllipsis" Margin="0,0,0,16"/>
                                <Button Content="ЧИТАТЬ ДАЛЕЕ" Command="{Binding OpenArticleCommand}" CommandParameter="{Binding FeaturedArticle}" Style="{StaticResource DeusButton}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Column="1" BorderBrush="{StaticResource BorderDim}" BorderThickness="1" Background="#F20A0A0A">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#CC141414" Padding="8" BorderBrush="{StaticResource BorderDim}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="ПО СВЕЖЕСТИ" Foreground="{StaticResource NeonYellow}" FontFamily="Consolas" FontWeight="Bold"/>
                                </Border>
                                <ListBox Grid.Row="1" ItemsSource="{Binding Articles}" Style="{StaticResource DeusListBox}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontFamily="Georgia" FontSize="12" Foreground="#FFD0D0D0" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding SourceName}" Style="{StaticResource DimTextStyle}"/>
                                                </StackPanel>
                                                <Grid.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenArticleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                                </Grid.InputBindings>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Visibility="{Binding IsReadingMode, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#CC141414" Padding="8" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="← НАЗАД" Command="{Binding BackToFeedCommand}" Style="{StaticResource DeusButton}"/>
                                <TextBlock Text="{Binding SelectedArticle.Title}" FontFamily="Georgia" FontSize="16" Foreground="#FFD0D0D0" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <wv2:WebView2 x:Name="ArticleBrowser" Grid.Row="1"/>
                    </Grid>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="#CC141414" BorderBrush="{StaticResource BorderDim}" BorderThickness="0,1,0,0">
                <Canvas ClipToBounds="True">
                    <TextBlock Style="{StaticResource MarqueeText}" Text="{Binding MarqueeText}"/>
                </Canvas>
            </Border>
        </Grid>
    </Border>
</Window>