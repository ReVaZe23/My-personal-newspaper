<Window x:Class="MyPersonalNewspaper.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Splash" 
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/DeusExTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Корневой контейнер, который будет обрезан по форме шестиугольника -->
    <Grid Width="500" Height="450" Background="Transparent">
        <Grid.Clip>
            <PathGeometry>
                <PathFigure StartPoint="250,0" IsClosed="True">
                    <LineSegment Point="500,125" />
                    <LineSegment Point="500,375" />
                    <LineSegment Point="250,500" />
                    <LineSegment Point="0,375" />
                    <LineSegment Point="0,125" />
                </PathFigure>
            </PathGeometry>
        </Grid.Clip>

        <!-- Картинка внутри обрезанного Grid -->
        <Image x:Name="BackgroundImage" Stretch="UniformToFill"/>

        <!-- Затемнение для читаемости текста -->
        <Border Background="#B3000000"/>

        <!-- Контент (текст, прогресс-бар) -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="GreetingText" 
                           FontFamily="Georgia" 
                           FontSize="28" 
                           Foreground="{StaticResource NeonYellow}"
                           TextAlignment="Center"
                           Margin="0,0,0,16"/>

                <TextBlock x:Name="UserNameText" 
                           FontFamily="Consolas" 
                           FontSize="18" 
                           Foreground="#FFD0D0D0"
                           TextAlignment="Center"/>

                <ProgressBar x:Name="LoadBar" Height="4" Width="300" Margin="0,30,0,0" 
                             Background="#FF1A1A1A" Foreground="{StaticResource NeonCyan}"
                             BorderThickness="0"/>
            </StackPanel>

            <TextBlock Grid.Row="1" Text="СИСТЕМА ЗАГРУЗКИ // DEUS INTERFACE" 
                       FontFamily="Consolas" FontSize="10" Foreground="{StaticResource DimText}" 
                       HorizontalAlignment="Center" Margin="0,0,0,40"/>
        </Grid>
    </Grid>
</Window>